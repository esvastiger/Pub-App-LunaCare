{
  "name": "lunacare",
  "version": "0.1.0",
  "description": "Seguimiento privado del ciclo menstrual: PWA con cifrado AES-256-GCM en el dispositivo, sin cuentas obligatorias ni rastreo.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve --port 4200 --host 127.0.0.1",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node tools/generate-icons.mjs",
    "screenshots": "node tools/screenshots.mjs",
    "social-card": "node tools/social-card.mjs"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.7",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.28",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "puppeteer@25.12.0": true
  }
}
